# ==============================================================================
# CyberShield Local Offline Server Configuration
# ==============================================================================

# Local PostgreSQL Database Connection String
# Syntax: postgresql://<username>:<password>@localhost:5432/<database_name>
# Replace "postgres" with whatever password you set during PostgreSQL installation:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cybershield

# Web Server Port (Default is 3000, or change to 80 for direct IP access)
PORT=3000
